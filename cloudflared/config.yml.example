# Konfigurasi tunnel di /etc/cloudflared/config.yml (butuh sudo, lalu
# `systemctl restart cloudflared`). Ganti <tunnel-id> dengan ID tunnel.
#
# Hanya hostname aplikasi dan webhook yang lewat tunnel. Datastore dan tampilan
# operasional tidak pernah punya hostname; mereka dijangkau lewat SSH port
# forwarding.
tunnel: <tunnel-id>
credentials-file: /home/nskuy/.cloudflared/<tunnel-id>.json

ingress:
  - hostname: ssh.hostingskuy.cloud
    service: ssh://localhost:22
  # Webhook GitHub ke Jenkins. Hanya path ini yang diteruskan; path lain di
  # hostname ini dijawab 404, jadi tampilan Jenkins tidak terjangkau dari
  # internet. Setiap kiriman diperiksa tanda tangannya dengan secret webhook.
  - hostname: platform-webhook.hostingskuy.cloud
    path: ^/github-webhook/$
    service: http://127.0.0.1:8090
  - hostname: platform-webhook.hostingskuy.cloud
    service: http_status:404
  # Semua hostname lain yang record DNS-nya menunjuk ke tunnel diteruskan ke
  # Traefik, yang memilih aplikasinya lewat Ingress dan menjawab 404 untuk
  # hostname yang tidak dikenalnya. Project baru cukup dibuatkan record DNS:
  #   cloudflared tunnel route dns <tunnel-id> <project>-<env>.hostingskuy.cloud
  # tanpa mengubah berkas ini, jadi tanpa sudo.
  - service: http://10.43.0.80:80

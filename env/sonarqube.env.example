# Disalin menjadi sonarqube.env oleh `make env`. Kata sandi role sonarqube di
# Postgres platform.
SONAR_JDBC_PASSWORD=__GENERATE__
# Kata sandi user admin di UI SonarQube, dipasang scripts/sonarqube-init.sh.
# SonarQube mewajibkan huruf besar, huruf kecil, angka, dan simbol; heksadesimal
# acak saja ditolak, jadi diberi akhiran. Sengaja tidak berawalan SONAR_:
# SonarQube membaca setiap variabel SONAR_* sebagai properti.
SONARQUBE_ADMIN_PASSWORD=__GENERATE__Aa1.

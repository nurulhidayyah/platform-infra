# Disalin menjadi jenkins.env oleh `make env`. Kata sandi user admin Jenkins.
JENKINS_ADMIN_PASSWORD=__GENERATE__
# Secret bersama webhook GitHub: GitHub menandatangani setiap kiriman dengan
# ini, dan Jenkins menolak kiriman yang tanda tangannya salah.
GITHUB_WEBHOOK_SECRET=__GENERATE__
# Token classic GitHub dengan scope read:packages saja, untuk menarik library
# Maven bersama dari GitHub Packages. Dibuat di github.com/settings/tokens;
# `make env` tidak bisa membuatnya, jadi isi dengan tangan.
GITHUB_PACKAGES_TOKEN=
